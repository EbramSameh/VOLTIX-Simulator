rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in builder can access only their own saved projects.
    match /users/{userId}/projects/{projectId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Public, non-sensitive builder profiles and competition rankings.
    // A user can write only the profile document matching their own UID.
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Shared circuits can be opened by anyone only when explicitly public.
    // Only the signed-in owner may create or remove their own share.
    match /sharedProjects/{shareId} {
      allow read: if resource.data.visibility == 'public';
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility == 'public';
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}